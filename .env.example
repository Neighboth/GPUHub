# GPUHub example configuration. Copy to .env and fill in real values.
# NEVER commit a real .env to version control.

# REQUIRED: master key for AES-256-GCM encryption of provider credentials and proxy URLs.
# Generate with: openssl rand -base64 32
GPUHUB_MASTER_KEY=change-me-to-a-long-random-string-at-least-16-chars

# Recommended: separate secret for signing JWTs. If empty, derived from GPUHUB_MASTER_KEY.
GPUHUB_JWT_SECRET=

# First-boot admin (used only when no users exist yet).
# If ADMIN_PASSWORD is empty, a first-run wizard in the UI creates the admin instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Port (container listens on 8080)
GPUHUB_PORT=8080
GPUHUB_DATA_DIR=/data
GPUHUB_DB_PATH=/data/gpuhub.db

# Scheduler & rotation (key rotation among keys of one provider; proxies NEVER rotate)
# round_robin | least_used | most_quota | weighted
GPUHUB_SCHEDULER_STRATEGY=most_quota
GPUHUB_ROTATION_STRATEGY=most_quota
GPUHUB_MAX_RETRIES=3
GPUHUB_QUOTA_HIGH_WATERMARK=0.90

# Proxy health checks (bound proxies only; unhealthy => key disabled, NO auto rebind)
GPUHUB_PROXY_HEALTH_URL=https://api.ipify.org?format=json
GPUHUB_NOTIFY_WEBHOOK_URL=

# Base URL for links/docs
GPUHUB_BASE_URL=http://localhost:8080

# Dev mode only (ephemeral master key): GPUHUB_DEV=1
GPUHUB_DEV=
